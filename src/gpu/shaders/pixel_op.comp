// The per-pixel colour nodes (nodes/ColorNodes.cpp, PixelOp): Grade (and its reverse), Multiply,
// Add, Gamma, Invert, Clamp, Premult, Unpremult, Saturation, ColorCorrect, with the "(un)premult
// by" step folded in. In place on an interleaved tile; one invocation per pixel. The maths is the
// CPU's, in the same order.
#version 450
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer Img { float img[]; };
// [0..15] the selected channels, [16..31] their component (R G B A -> 0..3), [32..] the op's numbers
layout(std430, set = 0, binding = 1) readonly buffer Prm { float prm[]; };

layout(push_constant) uniform P {
    int count;    // pixels
    int n;        // channels a pixel
    int op;       // 0 grade, 1 grade reverse, 2 multiply, 3 add, 4 gamma, 5 invert, 6 clamp,
                  // 7 premult, 8 unpremult, 9 saturation, 10 colorcorrect
    int nsel;     // selected channels
    int ua;       // unpremult by this channel (-1: no)
    int invUp;    // ... by 1 - it
    int flags;    // grade: 1 black clamp, 2 white clamp; colorcorrect: 1/2/4/8 range M/S/Mi/H not identity
    int ai;       // premult / unpremult: the alpha channel
    int r, g, b;  // saturation / colorcorrect: the colour channels
    int mode;     // saturation: 0 Rec 709, 1 CCIR 601, 2 average, 3 maximum
    float s;      // saturation
} p;

const int K = 32;

float luma709(float r, float g, float b) {
    precise float l = 0.2126 * r + 0.7152 * g + 0.0722 * b;
    return l;
}

// pow as the CPU's std::pow does it for x <= 0 (GLSL leaves that undefined)
float powc(float x, float y) {
    if (x > 0.0) return pow(x, y);
    if (x == 0.0) return y > 0.0 ? 0.0 : y == 0.0 ? 1.0 : 1.0 / 0.0;
    return pow(x, y);  // negative x: callers never pass one
}

float smooth3(float e0, float e1, float x) {
    float t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
    precise float r = t * t * (3.0 - 2.0 * t);
    return r;
}

// one ColorCorrect range (sat, contrast, gamma, gain, offset; 3 each) at prm[o..o+15)
void ccRange(int o, inout vec3 rgb) {
    float l = luma709(rgb.x, rgb.y, rgb.z);
    for (int c = 0; c < 3; ++c) {
        float sat = prm[o + c], con = prm[o + 3 + c], gam = prm[o + 6 + c], gain = prm[o + 9 + c], off = prm[o + 12 + c];
        precise float v = l + (rgb[c] - l) * sat;
        if (con != 1.0) v = 0.18 * powc(max(v, 0.0) / 0.18, con) + min(v, 0.0);
        if (gam != 1.0 && v > 0.0 && gam > 0.0) v = pow(v, 1.0 / gam);
        v = v * gain + off;
        rgb[c] = v;
    }
}

float one(int op, float v, int c, float alpha) {
    if (op == 0) {
        precise float t = prm[K + c] * v + prm[K + 4 + c];
        float gg = prm[K + 8 + c];
        if (gg != 1.0 && t > 0.0) t = pow(t, gg);
        if ((p.flags & 1) != 0 && t < 0.0) t = 0.0;
        if ((p.flags & 2) != 0 && t > 1.0) t = 1.0;
        return t;
    }
    if (op == 1) {
        float gg = prm[K + 8 + c];
        precise float t = v;
        if (t > 0.0 && gg != 1.0) t = pow(t, gg);
        t = (t - prm[K + 4 + c]) / prm[K + c];
        if ((p.flags & 1) != 0 && t < 0.0) t = 0.0;
        if ((p.flags & 2) != 0 && t > 1.0) t = 1.0;
        return t;
    }
    if (op == 2) return v * prm[K + c];
    if (op == 3) return v + prm[K + c];
    if (op == 4) {
        float e = prm[K + c];  // 1 / gamma, or <= 0: leave it
        return (v > 0.0 && e > 0.0) ? pow(v, e) : v;
    }
    if (op == 5) return 1.0 - v;
    if (op == 6) return clamp(v, prm[K + c], prm[K + 4 + c]);
    if (op == 7) return v * alpha;
    if (op == 8) return alpha != 0.0 ? v / alpha : v;
    return v;
}

void main() {
    const int i = int(gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u);
    if (i >= p.count) return;
    const int base = i * p.n;
    // (un)premult by: divide the selected colour by alpha before, multiply by the input's after
    float ual = 0.0;
    if (p.ua >= 0) {
        ual = img[base + p.ua];
        if (p.invUp != 0) ual = 1.0 - ual;
        if (ual > 1e-8)
            for (int k = 0; k < p.nsel; ++k) {
                int ch = int(prm[k]);
                if (ch != p.ua) img[base + ch] = img[base + ch] / ual;
            }
    }
    if (p.op <= 8) {
        // premult / unpremult read the alpha as the CPU's channel-at-a-time loop sees it: as it
        // came in until the alpha channel itself has been done (it's normally the last)
        float alpha = p.ai >= 0 ? img[base + p.ai] : 0.0;
        for (int k = 0; k < p.nsel; ++k) {
            int ch = int(prm[k]), c = int(prm[16 + k]);
            float v = one(p.op, img[base + ch], c, alpha);
            img[base + ch] = v;
            if (ch == p.ai) alpha = v;
        }
    } else if (p.op == 9) {
        float R = img[base + p.r], G = img[base + p.g], B = img[base + p.b];
        precise float l;
        if (p.mode == 0) l = luma709(R, G, B);
        else if (p.mode == 1) l = 0.299 * R + 0.587 * G + 0.114 * B;
        else if (p.mode == 2) l = (R + G + B) / 3.0;
        else l = max(R, max(G, B));
        precise float r2 = l + (R - l) * p.s, g2 = l + (G - l) * p.s, b2 = l + (B - l) * p.s;
        img[base + p.r] = r2;
        img[base + p.g] = g2;
        img[base + p.b] = b2;
    } else if (p.op == 10) {
        vec3 c0 = vec3(img[base + p.r], img[base + p.g], img[base + p.b]);
        float l = luma709(c0.x, c0.y, c0.z);
        float ws = 1.0 - smooth3(0.0, 0.09, l);
        float wh = smooth3(0.5, 1.0, l);
        float wm = max(0.0, 1.0 - ws - wh);
        vec3 bs = c0;
        if ((p.flags & 1) != 0) ccRange(K, bs);
        vec3 s = bs, m = bs, h = bs;
        if ((p.flags & 2) != 0) ccRange(K + 16, s);
        if ((p.flags & 4) != 0) ccRange(K + 32, m);
        if ((p.flags & 8) != 0) ccRange(K + 48, h);
        precise vec3 o = ws * s + wm * m + wh * h;
        img[base + p.r] = o.x;
        img[base + p.g] = o.y;
        img[base + p.b] = o.z;
    }
    if (p.ua >= 0) {
        // the input's alpha: the channel may have been changed above when it's selected
        // (the CPU premultiplies by the source's), so ual from before is what's used
        if (ual > 1e-8)
            for (int k = 0; k < p.nsel; ++k) {
                int ch = int(prm[k]);
                if (ch != p.ua) img[base + ch] = img[base + ch] * ual;
            }
    }
}
