// Windows resources: the program icon (Explorer, taskbar, Alt-Tab) and version details.
#include <winver.h>
1 ICON "@CMAKE_SOURCE_DIR@/assets/brand/welder.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "welderfx"
      VALUE "FileDescription",  "Welder compositor"
      VALUE "FileVersion",      "@PROJECT_VERSION@"
      VALUE "ProductName",      "Welder"
      VALUE "ProductVersion",   "@PROJECT_VERSION@"
      VALUE "LegalCopyright",   "AGPL-3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
