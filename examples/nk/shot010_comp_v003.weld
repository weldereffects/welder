        "x": 0,
        "y": 140,
        "nk_class": "Output"
      },
      "group": "BG_Look"
    },
    {
      "name": "Merge_FG",
      "type": "Merge",
      "inputs": [
        "BG_Look",
        "FG_Defocus"
      ],
      "params": {
        "operation": "over"
      },
      "ui": {
        "x": 0,
        "y": -130,
        "nk_class": "Merge2"
      }
    },
    {
      "name": "Glow_Matte",
      "type": "Dilate",
      "inputs": [
