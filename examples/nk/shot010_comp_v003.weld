      }
    },
    {
      "name": "Premult1",
      "type": "Premult",
      "inputs": [
        "Copy1"
      ],
      "params": {},
      "ui": {
        "x": -250,
        "y": -240,
        "nk_class": "Premult"
      }
    },
    {
      "name": "FG_Move",
      "type": "Transform",
      "inputs": [
        "Premult1"
      ],
      "params": {
        "translate": [
          {
            "keys": [
              [
                1.0,
                -600.0
              ],
              [
                24.0,
                600.0
              ]
            ],
            "interp": "smooth"
          },
          {
            "keys": [
              [
                1.0,
                0.0
              ],
              [
                12.0,
                120.0
              ],
              [
                24.0,
                0.0
              ]
            ],
            "interp": "smooth"
          }
        ],
        "rotate": {
          "keys": [
            [
              1.0,
              0.0
            ],
            [
              24.0,
              90.0
            ]
          ],
          "interp": "linear"
        },
        "scale": [
          0.6,
          0.6
        ],
        "center": [
          960.0,
          540.0
        ],
        "filter": "cubic",
        "motionblur": 1.0,
        "shutteroffset": "centred"
      },
      "ui": {
        "x": -250,
        "y": -180,
        "nk_class": "Transform"
      }
    },
    {
      "name": "FG_Defocus",
      "type": "Blur",
      "inputs": [
        "FG_Move"
      ],
      "params": {
        "size": {
          "expr": "FG_Move.scale.w*20"
        },
        "channels": "rgba"
      },
      "ui": {
        "x": -250,
        "y": -130,
        "nk_class": "Blur"
      }
    },
    {
      "name": "BG_Plate",
      "type": "CheckerBoard",
      "inputs": [],
      "params": {
        "size": 96.0,
        "color0": [
          0.05,
          0.06,
          0.08,
          1.0
        ],
        "color1": [
          0.18,
          0.2,
          0.24,
          1.0
        ]
      },
      "ui": {
        "x": 0,
        "y": -350,
        "nk_class": "CheckerBoard2"
      }
    },
    {
      "name": "BG_Grade",
      "type": "Grade",
      "inputs": [
        "BG_Plate"
      ],
      "params": {
        "channels": "rgb",
        "blackpoint": 0.01,
        "gain": [
          1.1,
          1.05,
          0.95,
          1.0
