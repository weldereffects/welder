        ]
      },
      "ui": {
        "x": -250,
        "y": -350,
        "nk_class": "Constant"
      }
    },
    {
      "name": "Copy1",
      "type": "Copy",
      "inputs": [
        "FG_Color",
        "FG_Matte"
      ],
      "params": {
        "from": [
          "A"
        ],
        "to": [
          "A"
        ]
      },
      "ui": {
        "x": -250,
        "y": -280,
