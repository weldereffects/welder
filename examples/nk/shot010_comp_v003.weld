      },
      "ui": {
        "x": -380,
        "y": -80,
        "nk_class": "Dilate"
      }
    },
    {
      "name": "Glow_Blur",
      "type": "Blur",
      "inputs": [
        "Glow_Matte"
      ],
      "params": {
        "size": 60.0
      },
      "ui": {
        "x": -380,
        "y": -40,
        "nk_class": "Blur"
      }
    },
    {
      "name": "Merge_Glow",
      "type": "Merge",
      "inputs": [
        "Merge_FG",
        "Glow_Blur"
      ],
      "params": {
        "operation": "plus",
        "mix": 0.35
      },
      "ui": {
        "x": 0,
        "y": -40,
        "nk_class": "Merge2"
      }
    },
    {
      "name": "Denoise1",
      "type": "OFX",
      "inputs": [
