 "ic_loras": {
  "_comment": "Presets for the LTX node. model: the models entry; control: what the reference video is made of (input = the src input as is). prompt: the template the panel's 'template' button puts in the prompt; replace the <...> parts.",
  "Alpha Gen": {
   "model": "ltx-ic-alpha-gen",
   "strength": 1.0,
   "control": "input",
   "prompt": "",
   "trained": [
    1920,
    1088,
    121
   ],
   "note": "Returns a matte (white = foreground). Prompt stays empty."
  },
  "Pixel Upscaler x2": {
   "model": "ltx-ic-upscaler",
   "strength": 1.0,
   "control": "input",
   "prompt": "",
   "scale": 2,
   "trained": [
    1920,
    1088,
    121
   ],
   "note": "Output is twice the input size; it invents detail, it is not a pixel-accurate upscale."
  },
  "Water Simulation": {
   "model": "ltx-ic-water",
   "strength": 1.0,
   "control": "input",
   "prompt": "Reference shows <the scene>. Edited shows the same scene with water added. ADD WATER <describe the result>. The identity, layout and framing stay identical to the reference.",
   "trained": [
    1920,
    1088,
    121
   ],
   "note": "Describe the water. Keep the ADD WATER trigger."
  },
  "Colorization": {
   "model": "ltx-ic-colorize",
   "strength": 1.0,
   "control": "input",
   "prompt": "Reference shows <the scene>. Edited shows the same scene with natural colors restored. COLORIZE <describe the result>. Only color information differs between reference and edited.",
   "trained": [
    960,
    544,
    121
   ],
   "note": "Lower the strength to 0.8-0.9 if colours bleed."
  },
  "Decompression": {
   "model": "ltx-ic-decompress",
   "strength": 1.0,
   "control": "input",
   "prompt": "Reference shows <the scene>, heavily compressed with visible macroblocking. ENHANCE QUALITY <describe the result>. Only compression artifacts and image quality differ between reference and edited.",
   "trained": [
    960,
    544,
    121
   ],
   "note": ""
  },
  "Deblur": {
   "model": "ltx-ic-deblur",
   "strength": 1.0,
   "control": "input",
   "prompt": "Reference shows <the scene>, out of focus. Edited shows the same scene in sharp focus. DEBLUR <describe the result>",
   "trained": [
    1920,
    1088,
    121
   ],
   "note": "For defocus, not motion blur. Sweep strength 0.5-1."
  },
  "Day to Night": {
   "model": "ltx-ic-day-to-night",
   "strength": 1.0,
   "control": "input",
   "prompt": "Reference shows <the scene> in daylight. Edited shows the same scene at night: <describe the result>. Only the lighting changes from day to night.",
   "trained": [
    768,
    448,
    97
   ],
   "note": ""
  },
  "Union Control (depth)": {
   "model": "ltx-ic-union",
   "strength": 1.0,
   "control": "depth",
   "prompt": "<describe the result>",
   "trained": [
    1920,
    1088,
    121
   ],
   "note": "LTX-2.3 adapter on LTX-2.5 (as Lightricks' 2.5 workflows do). The depth video is made from src (or feed a depth pass and choose control 'input')."
  },
  "Union Control (edges)": {
   "model": "ltx-ic-union",
   "strength": 1.0,
   "control": "canny",
   "prompt": "<describe the result>",
   "trained": [
    1920,
    1088,
    121
   ],
   "note": "LTX-2.3 adapter on LTX-2.5. Canny edges are made from src."
  },
  "Union Control (as is)": {
   "model": "ltx-ic-union",
   "strength": 1.0,
   "control": "input",
   "prompt": "<describe the result>",
   "trained": [
    1920,
    1088,
    121
   ],
   "note": "Feed a depth, pose or edge video into src yourself."
  },
  "Motion Control": {
   "model": "ltx-ic-motion",
   "strength": 1.0,
   "control": "input",
   "prompt": "<describe the result>",
   "trained": [
    1920,
    1088,
    121
   ],
   "note": "src: the shot with coloured motion-path splines drawn over it (e.g. RotoPaint strokes)."
  },
  "Inpaint": {
   "model": "ltx-ic-inoutpaint",
   "strength": 1.0,
   "control": "inpaint",
   "prompt": "<describe the result>",
   "trained": [
    1920,
    1088,
    121
   ],
   "note": "The mask input (alpha) marks what to replace; it is painted #66FF00 into the reference. Include shadows in the mask."
  },
  "Relight": {
   "model": "ltx-ic-relight",
   "strength": 1.0,
   "control": "relight",
   "prompt": "relight the video to match the light-direction ball. <describe the result>",
   "trained": [
    1280,
    704,
    121
   ],
   "note": "A shaded ball showing the light direction is drawn top right of every frame. Describe the look and where the light comes from."
  }
 }
